#. name = data['name-slug']
#: webfontkitgenerator/generator.py:79
#, python-brace-format
msgid "Generating fonts for {name}:"
msgstr "Генерування шрифтів для {name}:"

#: webfontkitgenerator/generator.py:81
#, python-brace-format
msgid "Generating {name}"
msgstr "Генерування {name}"

#: webfontkitgenerator/generator.py:142
#, python-brace-format
msgid "Generated <i>{filename}</i> with <i>{count}</i> glyphs."
msgstr "Згенеровано <i>{filename}</i> із <i>{count}</i> гліфами."

#: webfontkitgenerator/generator.py:156
#, python-brace-format
msgid "No glyphs where found for {range}. Skipping."
msgstr "Для {range} не знайдено жодного гліфа. Пропускаємо."

#: webfontkitgenerator/generator.py:171
msgid "Generating CSS:"
msgstr "Генерування CSS:"

#: webfontkitgenerator/generator.py:172
msgid "Finishing"
msgstr "Завершення"

#: webfontkitgenerator/generator.py:193
#, python-brace-format
msgid "Generated <i>{filename}</i>."
msgstr "Згенеровано <i>{filename}</i>."

#: webfontkitgenerator/generator.py:197
msgid "There is no CSS to generate."
msgstr "Немає CSS для генерування."

#: webfontkitgenerator/google.py:91
msgid "Loading Google Fonts Database"
msgstr "Завантаження бази даних Google Fonts"

#: webfontkitgenerator/google.py:160
msgid "Couldn’t download the Google Fonts data."
msgstr "Не вдалося завантажити дані Google Fonts."

#: webfontkitgenerator/google.py:191
#, python-brace-format
msgid "Couldn’t find the {variant} variant for {family_name}."
msgstr "Не вдалося знайти варіант {variant} для {family_name}."

#. If no family found, add error to list
#: webfontkitgenerator/google.py:199
#, python-brace-format
msgid "Couldn’t find the {family_name} font family."
msgstr "Не вдалося знайти сімейство шрифтів {family_name}."

#. If not files found at all, show general error and terminate
#: webfontkitgenerator/google.py:208
msgid "Couldn’t find any fonts for the given url."
msgstr "Не знайдено жодного шрифту за URL-адресою."

#: webfontkitgenerator/google.py:280
msgid "Please set a valid url"
msgstr "Вкажіть дійсну URL-адресу"

#: webfontkitgenerator/google.py:308
#, python-brace-format
msgid "Downloading {name}"
msgstr "Завантаження {name}"

#: webfontkitgenerator/google.py:332
#, python-brace-format
msgid "Couldn’t download the font file for {name}."
msgstr "Не вдалося завантажити файл шрифту для {name}."

#: webfontkitgenerator/google.py:353
#, python-brace-format
msgid "Couldn’t write the font file for {name}."
msgstr "Не вдалося записати файл шрифту для {name}."

#: webfontkitgenerator/loader.py:67
#, python-brace-format
msgid "You don’t have read access to {font} or it doesn’t exists."
msgstr "У вас немає прав на читання {font}, або він не існує."

#: webfontkitgenerator/loader.py:76
#, python-brace-format
msgid "Error: {error}."
msgstr "Помилка: {error}."
